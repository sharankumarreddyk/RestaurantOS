{
  "name": "restaurant-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Restaurant E-Menu & Management Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "migrate": "cd server && npm run migrate",
    "seed": "cd server && npm run seed",
    "setup": "npm install && cd server && npm install && cd ../client && npm install && cd .. && npm run migrate && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
