{
  "name": "restaurant-platform-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seeds/run.js",
    "migrate:create": "node src/db/create-migration.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'ESLint configured - run npx eslint src/'"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/static": "^7.0.1",
    "@fastify/websocket": "^9.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/compress": "^7.0.0",
    "@fastify/csrf-protection": "^6.4.1",
    "pg": "^8.11.3",
    "knex": "^3.1.0",
    "redis": "^4.6.12",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "sharp": "^0.33.2",
    "qrcode": "^1.5.3",
    "dotenv": "^16.4.1",
    "zod": "^3.22.4",
    "pino-pretty": "^10.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "vitest": "^1.3.0"
  }
